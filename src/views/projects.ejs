<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <h2>Upcoming Service Projects</h2>
  <% if (user?.role_name === 'admin') { %>
    <p><a href="/new-project">Add a New Service Project</a></p>
  <% } %>

  <nav>
  <% projects.forEach(project => { %>
    <div class="project-item">
    <span><%= project.date.getDate() %>/<%= project.date.getMonth() + 1 %>/<%= project.date.getFullYear() %> <%= project.date.getHours() %>h</span>
    <strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong>
    <a href="/organization/<%= project.organization_id %>">(<%= project.organization_name %>)</a>
    <% if (project.categories.length) { %>
      <span>Categories: <% project.categories.forEach((category, index) => { %><a href="/category/<%= category.category_id %>"><%= category.name %></a><%= index < project.categories.length - 1 ? ', ' : '' %><% }) %></span>
    <% } %>
    </div>
    <% }) %>
  </nav>
</main>
<%- include('partials/footer') %>
