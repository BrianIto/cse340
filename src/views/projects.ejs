<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <h2>Upcoming Service Projects</h2>

  <nav>
  <% projects.forEach(project => { %>
    <div class="project-item">
    <span><%= project.date.getDate() %>/<%= project.date.getMonth() + 1 %>/<%= project.date.getFullYear() %> <%= project.date.getHours() %>h</span> <strong><span><%= project.title %> </span></strong><span>(<%= project.organization_name %>)</span></div>
    <% }) %>
  </nav>
</main>
<%- include('partials/footer') %>
