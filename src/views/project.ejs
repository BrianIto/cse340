<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <h2>Service Project Detail</h2>

	<h3><%= project.title %></h3>
	<% if (isLoggedIn) { %>
		<section class="volunteer-actions" aria-label="Volunteer options">
			<% if (isVolunteer) { %>
				<p>You are volunteering for this project.</p>
				<form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
					<button type="submit">Remove me as a volunteer</button>
				</form>
			<% } else { %>
				<form action="/project/<%= project.project_id %>/volunteer" method="POST">
					<button type="submit">Volunteer for this project</button>
				</form>
			<% } %>
		</section>
	<% } %>
	<% if (user?.role_name === 'admin') { %>
		<p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
		<p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
	<% } %>
	<ul>
	<li><%= project.description %></li>
	<li>
<%= project.date.getDate() %>/<%= project.date.getMonth() + 1 %>/<%= project.date.getFullYear() %> <%= project.date.getHours() %>h
</li>

	<li><%= project.location %></li>
	<li><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></li>
	</ul>
</main>
<%- include('partials/footer') %>
