<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <h2>Service Project Detail</h2>

	<h3><%= project.title %></h3>
	<% if (user?.role_name === 'admin') { %>
		<p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
		<p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
	<% } %>
	<ul>
	<li><%= project.description %></li>
	<li>
<%= project.date.getDate() %>/<%= project.date.getMonth() + 1 %>/<%= project.date.getFullYear() %> <%= project.date.getHours() %>h
</li>

	<li><%= project.location %></li>
	<li><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></li>
	</ul>
</main>
<%- include('partials/footer') %>
