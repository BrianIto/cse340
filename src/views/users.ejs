<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <% if (users.length === 0) { %>
    <p>No users have registered yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Email</th>
          <th scope="col">Role</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(account => { %>
          <tr>
            <td><%= account.name %></td>
            <td><%= account.email %></td>
            <td><%= account.role_name %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</main>
<%- include('partials/footer') %>
